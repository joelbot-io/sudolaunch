{
  "name": "sudolaunch",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "SudoLaunch",
  "description": "Global-hotkey command palette, modular desktop dock, drop-down PowerShell terminal, in-app cron scheduler, and workstation management suite for Windows.",
  "homepage": "https://github.com/joelbot-io/sudolaunch#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/joelbot-io/sudolaunch.git"
  },
  "bugs": {
    "url": "https://github.com/joelbot-io/sudolaunch/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "release:win": "electron-vite build && electron-builder --win --publish always",
    "bundle": "powershell -ExecutionPolicy Bypass -File ./scripts/bundle-repo.ps1",
    "bundle:native": "powershell -ExecutionPolicy Bypass -File ./scripts/bundle-repo.ps1 -IncludeNative",
    "bundle:zip": "powershell -ExecutionPolicy Bypass -File ./scripts/bundle-repo.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node ./scripts/postinstall.js",
    "rebuild:native": "electron-rebuild -f -o node-window-manager,extract-file-icon,electron-clipboard-ex,node-pty",
    "profile:backup": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-profile.ps1",
    "profile:restore": "powershell -ExecutionPolicy Bypass -File ./scripts/restore-profile.ps1",
    "profile:list": "powershell -ExecutionPolicy Bypass -File ./scripts/manage-profile.ps1 list",
    "profile:create": "powershell -ExecutionPolicy Bypass -File ./scripts/create-profile.ps1",
    "profile:validate": "powershell -ExecutionPolicy Bypass -File ./scripts/validate-profile.ps1",
    "profile:clean-history": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-history.ps1",
    "profile:repair-env": "powershell -ExecutionPolicy Bypass -File ./scripts/repair-environment.ps1",
    "profile:import-teams": "powershell -ExecutionPolicy Bypass -File ./scripts/import-team-links.ps1",
    "profile:export": "powershell -ExecutionPolicy Bypass -File ./scripts/export-profile.ps1",
    "profile:import-bundle": "powershell -ExecutionPolicy Bypass -File ./scripts/import-profile.ps1",
    "profile:autostart": "powershell -ExecutionPolicy Bypass -File ./scripts/check-autostart.ps1",
    "profile:bookmarks": "powershell -ExecutionPolicy Bypass -File ./scripts/import-bookmarks.ps1",
    "profile:git-scan": "powershell -ExecutionPolicy Bypass -File ./scripts/scan-git-repos.ps1",
    "profile:new-cmd": "powershell -ExecutionPolicy Bypass -File ./scripts/new-command.ps1",
    "profile:hotkeys": "powershell -ExecutionPolicy Bypass -File ./scripts/check-hotkey-conflicts.ps1",
    "profile:apps": "powershell -ExecutionPolicy Bypass -File ./scripts/reindex-apps.ps1",
    "profile:clean-procs": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-processes.ps1",
    "profile:shell-sync": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-terminal-profile.ps1",
    "profile:manage": "powershell -ExecutionPolicy Bypass -File ./scripts/manage-profile.ps1",
    "setup:uiaccess": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-uiaccess.ps1",
    "uac:status": "powershell -ExecutionPolicy Bypass -File ./scripts/manage-secure-desktop.ps1 -Status",
    "uac:disable": "powershell -ExecutionPolicy Bypass -File ./scripts/manage-secure-desktop.ps1 -Disable",
    "uac:enable": "powershell -ExecutionPolicy Bypass -File ./scripts/manage-secure-desktop.ps1 -Enable"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^4.0.3",
    "electron-clipboard-ex": "^1.3.3",
    "electron-updater": "^6.3.9",
    "fuse.js": "^7.0.0",
    "mathjs": "^15.2.0",
    "node-pty": "^1.1.0",
    "node-window-manager": "^2.2.4",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
