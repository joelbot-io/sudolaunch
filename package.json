{
  "name": "sudolaunch",
  "private": true,
  "version": "0.1.0",
  "description": "Global-hotkey command palette for Windows: quick Teams chat/call, email, snippets, links, app launch, and calc.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-rebuild -f -w node-window-manager,electron-clipboard-ex,node-pty"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^4.0.3",
    "electron-clipboard-ex": "^1.3.3",
    "electron-updater": "^6.3.9",
    "fuse.js": "^7.0.0",
    "mathjs": "^13.2.0",
    "node-pty": "^1.1.0",
    "node-window-manager": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
